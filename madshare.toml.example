[api]
addr = ":3000"
# URL browsers use to reach the API — change this for remote/production deployments
public_url = "http://localhost:3000"

[webui]
addr = ":8080"

[database]
path = "./data/madshare.db"

[storage]
# Directory where uploaded blobs are stored and served from
files_dir = "./data/files"
# Maximum size of a single upload, in MiB
max_upload_mb = 500
