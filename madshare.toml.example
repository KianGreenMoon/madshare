# Madshare configuration. Copy to madshare.toml and edit. If no madshare.toml
# exists, the built-in defaults apply (a single loopback listener serving the
# full stack). See docs/architecture/listeners-and-config.md for the full model.

# data_dir is the default root for the database, uploaded files, and derived
# media. When database.path / storage.files_dir / storage.variants_dir are omitted
# they are derived from it as <data_dir>/madshare.db, <data_dir>/files and
# <data_dir>/variants; setting any overrides only that path. The default "./data"
# reproduces the historical layout.
# See docs/architecture/data-sources.md and docs/architecture/variants.md.
#data_dir = "./data"

# One [[listen]] block per bound socket. Each chooses which route groups it
# serves:
#   api    -> /healthz, /api/* (library), /files/*, /images/*   (the product)
#   webui  -> /, /static/*                                      (bundled UI)
#   admin  -> /api/admin/* (delete, prune) and the /admin page  (destructive)
#
# The bundled web UI talks to the API over relative, same-origin URLs, so no
# public URL is configured. A listener that serves "webui" should also serve
# "api", or the page loads but its calls 404.

# Default-equivalent: everything on loopback. Safe while admin is unauthed.
[[listen]]
addr  = "127.0.0.1"
port  = 3000
serve = ["api", "webui", "admin"]

# Example: also expose the API (only) to others. Bind a SPECIFIC address — do
# not pair this with 0.0.0.0 on the same port (0.0.0.0 includes loopback and
# the two bindings would collide). Reusing port 3000 on a different address is
# fine.
#[[listen]]
#addr  = "192.168.1.67"        # this host's LAN or yggdrasil address
#port  = 3000
#serve = ["api"]
#allow_from = ["192.168.1.0/24"]   # optional source-IP allowlist (not auth)

# [[listen_mesh]] serves the same route groups on THIS NODE'S OWN Yggdrasil
# address, over the embedded userspace netstack — the no-reverse-proxy way to be
# reachable from anywhere. No certificate, no domain, no port forwarding, no
# root: port 80 is free here because it is not a kernel socket. Requires the
# mesh ([yggdrasil] or [federation] below) and a build with federation in it.
#
# enabled DEFAULTS TO FALSE and must be set explicitly — writing the block is
# not enough, and enabling federation does not switch it on. Unlike a [[listen]]
# address you type yourself, this one is derived from the node key and its
# audience is the WHOLE Yggdrasil network, so it is never inherited by accident
# from an example or someone else's config. A block left off warns at startup,
# so it cannot silently do nothing either.
#
# There is no addr: a node has exactly one mesh address and derives it from its
# key. Port defaults to 80; 1314 is reserved for the madnetwork protocol.
#
# GOTCHA: that address is NOT reachable from this host (there is no TUN device),
# so keep a [[listen]] on loopback for local administration — as above.
#[[listen_mesh]]
#enabled = true                # REQUIRED; default false
#port    = 80
#serve   = ["api", "webui"]    # add "admin" to administer from off-host; its
                               # audience is the whole mesh, so auth is the gate

# Only set api_base for a SEPARATELY hosted web UI pointing at a remote backend.
# Leave empty (or omit) for the bundled server so the UI uses relative URLs.
#
# git_repo is the URL behind the header's "GitRepo" nav button:
#   omitted        -> the upstream default (https://github.com/KianGreenMoon/madshare)
#   git_repo = ""  -> the button is hidden
#   any other URL  -> linked as-is (point it at your fork if you changed the code)
# Note: GET /source (the AGPL corresponding-source download) stays available
# regardless of this setting — only the nav button changed.
#[webui]
#api_base = "https://media.example.org"
#git_repo = "https://github.com/KianGreenMoon/madshare"

# Cross-origin (CORS) access to the API. The bundled web UI is same-origin and
# needs none, so the default emits NO CORS headers (cross-origin browsers are
# blocked; non-browser clients like API tokens / curl are unaffected). Set this
# only for a SEPARATELY hosted browser UI or a third-party web client — it must
# match that UI's own origin (the scheme://host[:port] in the browser's URL bar),
# not [webui].api_base.
#   - list exact origins -> each is echoed back, with credentials allowed
#   - a single "*"        -> any origin, sent as "*" (no credentials, per spec)
# A malformed origin (missing scheme, has a path, etc.) is a fatal config error.
#[cors]
#allowed_origins = ["https://ui.example.org"]

# First-run admin bootstrap. These are consumed ONLY when the users table is
# empty (a fresh database): they create the first admin account, which is then
# forced to change its password on first login. On a fresh DB the user is
# required; afterwards both fields are ignored (and a warning is logged if set).
# Prefer supplying the password via the MADSHARE_INITIAL_ADMIN_PASSWORD env var
# rather than writing it into this file.
[auth]
initial_admin_user = "admin"
# initial_admin_password = "change-me"   # better: export MADSHARE_INITIAL_ADMIN_PASSWORD

[database]
#path = "./data/madshare.db"  # defaults to <data_dir>/madshare.db

[storage]
#files_dir    = "./data/files"      # defaults to <data_dir>/files; source audio blobs under <files_dir>/audio
#variants_dir = "./data/variants"   # defaults to <data_dir>/variants; cover variants under <variants_dir>/images
max_upload_mb = 500          # per-request upload cap, in MiB
# server_max_parallel_workers = 0   # total concurrent uploads from all users (0 = unlimited)
# user_max_parallel_workers   = 0   # concurrent uploads per user (0 = unlimited; no admin bypass)
# image_processing_workers    = 0   # cover-image resize goroutines; 0 = auto (number of CPUs)

# [yggdrasil] is the mesh TRANSPORT: the identity key, the underlay peering, and
# therefore this node's address. It is separable from [federation] below, which
# is the madnetwork FEATURE (friendship, catalogs, sharing scope). Enabling the
# transport alone gives a server a stable global address it can be reached at —
# see [[listen_mesh]] above — while federating with nobody.
#
# enabled is inferred from [federation].enabled when omitted, so a config written
# before the split keeps working; setting it to false while federation is enabled
# is an error, not an override (madnetwork has no other transport).
#
# key_file IS the node identity (PEM ed25519 — the mesh address derives from it,
# so back it up; losing it means coming back as a stranger). peers are outbound
# underlay URIs to join the mesh; listen accepts incoming peerings (backbone
# nodes only — a node behind NAT needs neither).
#
# Beside the key, startup writes two informational files (0644) so the address
# and the identity are readable without the server running or a log to grep:
#   <key_file>.pub          the public key, hex — what a friend identifies you by
#   <key_file minus .key>.addr  the mesh address — what you hand out
# With the default key that is data/federation.key.pub and data/federation.addr.
# Nothing reads them back; they are outputs, so they are rewritten whenever they
# disagree with the running identity, and deleting them just regenerates them.
#
# These three may still be written under [federation] (deprecated aliases) and an
# explicit [yggdrasil] value wins. Requires a build WITHOUT -tags nofederation.
#[yggdrasil]
#enabled  = true
#key_file = "./data/federation.key"           # defaults to <data_dir>/federation.key
#peers    = ["tls://peer.example:12345"]      # tcp/tls/quic/ws/wss/unix/socks/sockstls
#listen   = ["tls://0.0.0.0:12345"]           # tcp/tls/quic/ws/wss/unix

# [federation] controls the embedded madnetwork node (docs/architecture/federation.md).
# Disabled by default; requires a binary built WITHOUT -tags nofederation, and
# implies [yggdrasil].enabled since madnetwork is served over the mesh.
# The madnetwork protocol itself is served inside the mesh on port 1314 of the
# node's mesh address — no host port is opened.
# name is the display name shown on this node's card and to peers during
# pairing (host name when unset) — purely descriptive, identity is the key.
# Friendships are managed on /admin/network (exchange node cards out-of-band).
# cache_max_mb is the DEFAULT ceiling on the download cache (what the swarm
# fetched from other nodes), in MiB; 0 = no limit. Over it, least-recently-used
# blobs are evicted until it fits. Like the rates below it is overridable at
# runtime — on /admin/settings, where an empty field means "use this value" and
# a typed 0 means "no limit" as a deliberate choice. 0 ships as the default
# because a guessed one would start deleting other people's content on upgrade.
# seed_rate_kib caps the outbound rate (KiB/s) for serving blobs to EVERY
# requester (0 = unlimited), and fetch_rate_kib the inbound rate this node
# pulls at. Both are node-wide — a cap protects the line, which every transfer
# shares — and both can be overridden at runtime on /admin/swarm, which is
# where they belong when the link is already saturated. Size them against your
# UPLINK (KiB/s ≈ Mbit/s × 128), leaving about a quarter free; below what one
# listener needs (~125 KiB/s for CD-rate FLAC, shared by every concurrent
# serve) a node does not just get slower — fetching peers time it out and the
# swarm de-ranks it, so the bytes it did send are wasted. The seed on/off +
# cache-seed toggles are runtime settings on /admin/settings, not here. The four member_* knobs bound what a
# node we have no direct relationship with may cost: this node serves its whole
# community and membership has no admission cap, so bytes and concurrent blob
# serves are each capped per requester AND across all non-friends together (N
# forged keys would otherwise buy N per-requester quotas). Direct friends are
# outside all four — they are an admin's choice and must never queue behind the
# nodes the graph let in. All default to unlimited: a handful of friends needs
# none of this, so it is opt-in. reachable_window_sec is the availability
# freshness window: a friend counts as reachable (its exclusively-held tracks show
# in the madnetwork browse) when seen within it — 0 = default 180s, values below
# 120s are clamped up (anti-flap floor). Whether hiding applies at all is the
# runtime madnetwork.hide_unavailable toggle on /admin/settings.
# discovery_budget / discovery_cap bound how far past the friend ring this node
# pulls catalogs: friends are always pulled, and beyond them a few MEMBERS of the
# community per 15-minute cycle, rotating least-recently-tried first, with the
# cached foreign catalogs capped (coldest evicted). -1 as the budget turns
# discovery off — the node still serves its whole community, it just stops
# looking past the nodes this admin friended.
#
# fpcalc (Chromaprint) is REQUIRED once enabled = true, and the server refuses to
# start without it: a federated node re-fingerprints downloaded audio locally
# before it joins a recording, because a peer's claims about it are hints and
# never facts. allow_missing_fingerprinting = true federates anyway — the node
# then imports and re-publishes content it cannot verify, and downloads never
# group with recordings it already holds. ffprobe is only recommended: without it
# this node's catalog carries no quality facts, so friends cannot rank its
# renditions, but nothing goes unverified.
#[federation]
#enabled             = false
#name                = "my madshare"           # defaults to the host name
# key_file / peers / listen moved to [yggdrasil] above; still accepted here.
#seed_rate_kib       = 0                        # 0 = unlimited outbound seeding rate (everyone)
#fetch_rate_kib      = 0                        # 0 = unlimited inbound fetching rate
#member_rate_kib     = 0                        # KiB/s to all non-friends together
#per_member_rate_kib = 0                        # KiB/s to any one non-friend
#member_max_transfers     = 0                   # concurrent blob serves, all non-friends
#per_member_max_transfers = 0                   # concurrent blob serves, one non-friend
#cache_max_mb        = 0                        # download-cache ceiling, MiB; 0 = no limit
#reachable_window_sec = 180                     # availability freshness window (min 120)
#discovery_budget    = 4                        # member catalogs pulled per cycle (-1 = friends only)
#discovery_cap       = 200                      # cached foreign catalogs kept (coldest evicted)
#allow_missing_fingerprinting = false           # true = federate without fpcalc (unverified)

# [sources] controls in-place "symlink" imports: an admin points at an external
# directory and Madshare references each audio file by a symlink in the shared
# links storage (<data_dir>/links) — never copying, never modifying the originals.
# symlink_roots is the trust boundary: a symlink source may only reference a
# directory at or under one of these roots. Each entry must be an absolute,
# Clean-stable path. Empty (the default) disables symlink sources entirely (the
# local storage and uploads are unaffected). Deploy-time only — not UI-editable.
# See docs/architecture/data-sources.md.
#[sources]
#symlink_roots = ["/srv/music", "/mnt/nas/audio"]
# allow_any drops the allow-list: ANY absolute directory may be imported. It is
# for an EMBEDDED madshare with no listener (a native player — see
# docs/architecture/embedding.md), where the person adding a folder is at the
# keyboard. On a deployment that serves, this removes the boundary that listener
# needs, and startup warns about it.
#allow_any = false
