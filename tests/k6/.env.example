# k6 test suite configuration — copy to .env and edit, or pass any of these
# with `-e KEY=val`. k6 reads OS environment variables via __ENV, so you can:
#
#   set -a; source tests/k6/.env; set +a
#   k6 run tests/k6/scenarios/load.js
#
# tests/k6/.env is gitignored (it may hold credentials); this .example is tracked.

# ---- Target -----------------------------------------------------------------
BASE_URL=http://localhost:3000

# ---- Credentials (seeded test users) ----------------------------------------
ADMIN_USER=admin
ADMIN_PASS=password
UPLOADER_USER=uploader
UPLOADER_PASS=password
USER_USER=user
USER_PASS=password

# ---- Profile & scaling ------------------------------------------------------
# Which config/profiles/<name>.json to run.
PROFILE=standard
# Scale the whole profile: 1.0 = as written, 0.75 = lighter, 1.25 = heavier.
PROFILE_PROC=1.0
# Override a single case's requests/hour, e.g. PER_HOUR_upload=2000
#PER_HOUR_upload=

# ---- load.js run length (short = regression, long = soak) -------------------
DURATION=5m

# ---- Upload / delete --------------------------------------------------------
# Folder of audio for the upload case. Relative paths are resolved by k6
# relative to the script files (tests/k6/...); the default reaches repo test_data/.
# Prefer an absolute path when overriding.
TEST_AUDIO_DIR=../../../test_data
# delete case also purges from trash (hard delete). false = soft-delete only.
HARD_DELETE=true

# ---- capacity.js ramp (ramps PROFILE_PROC to the knee) ----------------------
RAMP_START=0.5
RAMP_STEP=0.5
RAMP_STEP_SECS=60
RAMP_MAX=5.0
