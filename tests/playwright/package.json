{
  "name": "madshare-playwright",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end (browser) tests for the Madshare web UI.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen ${BASE_URL:-http://localhost:3000}"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
