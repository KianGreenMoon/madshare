# Copy to `.env` (gitignored). The values below are the defaults already baked
# into playwright.config.ts / the specs — shown here for reference. Uncomment and
# edit to override.

# Base URL of the running Madshare server under test.
#BASE_URL=http://localhost:3000

# Credentials of a NON-first-run test user — i.e. one that has already completed
# any forced password change (see README "Test environment"). Matches the k6
# suite's seeded users.
#TEST_USER=user
#TEST_PASS=password
